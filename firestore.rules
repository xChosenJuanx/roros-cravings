rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email == "solidtagasogid26@gmail.com";
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "Pending";
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /orders/{orderId}/messages/{messageId} {
      allow read, create: if isAdmin() || (
        signedIn() &&
        get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid
      );
      allow update, delete: if false;
    }

    match /tracking/{trackingId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if signedIn() && request.resource.data.status == "Pending";
      allow update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow read, create, update: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /deviceTokens/{tokenId} {
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, delete: if isAdmin();
    }

    match /settings/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
